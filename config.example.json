{
  "worktree": "../myapp-backcheck",
  "branch": "backcheck/build",
  "providers": {
    "claude-sub": {
      "command": [
        "claude",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "model": "sonnet",
      "expect_model": "sonnet",
      "probe": true
    },
    "claude-api": {
      "command": [
        "claude",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "model": "opus",
      "expect_model": "opus",
      "env_from": {
        "ANTHROPIC_API_KEY": "BACKCHECK_ANTHROPIC_KEY"
      },
      "probe": true
    },
    "other-family": {
      "command": [
        "claude",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--dangerously-skip-permissions"
      ],
      "model": "REPLACE-with-the-endpoint's-model-id",
      "env": {
        "ANTHROPIC_BASE_URL": "https://REPLACE-anthropic-compatible-endpoint"
      },
      "env_from": {
        "ANTHROPIC_AUTH_TOKEN": "BACKCHECK_OTHER_KEY"
      },
      "probe": true
    }
  },
  "roles": {
    "builder": {
      "provider": "claude-sub",
      "fallback": "claude-api"
    },
    "reviewer": {
      "provider": "other-family",
      "fallback": "claude-api"
    },
    "planner": {
      "provider": "claude-api"
    }
  },
  "gate": [
    {
      "name": "build",
      "run": "go build ./..."
    },
    {
      "name": "vet",
      "run": "go vet ./..."
    },
    {
      "name": "tests",
      "run": "go test ./... 2>&1 | tail -80"
    }
  ],
  "preflight": [
    {
      "name": "postgres",
      "run": "pg_isready -h localhost"
    }
  ],
  "readonly_paths": [
    "database/migrations/",
    ".github/"
  ],
  "fingerprints": [
    {
      "name": "prod-db-schema",
      "run": "psql \"$PROD_RO_URL\" -Atc \"select md5(string_agg(table_name||column_name, ',' order by 1)) from information_schema.columns where table_schema='public'\""
    }
  ],
  "limits": {
    "session_wall_seconds": 5400,
    "session_idle_seconds": 900,
    "probe_timeout_seconds": 90,
    "max_consecutive_rework": 4,
    "max_stalled_sessions": 2,
    "max_session_failures": 5,
    "retry_backoff_seconds": 300,
    "unknown_wait_seconds": 1800,
    "reset_margin_seconds": 30,
    "poll_seconds": 10,
    "steps_per_session": "5 to 8",
    "min_free_disk_mb": 2048,
    "gate_output_chars": 6000,
    "max_sessions_per_wave": 40,
    "max_retries_before_operator": 20
  },
  "notify": {
    "command": [
      "notify-send",
      "-a",
      "backcheck",
      "-u",
      "critical"
    ],
    "human_events": [
      "halt",
      "needs-operator",
      "closed",
      "model-mismatch"
    ]
  }
}
